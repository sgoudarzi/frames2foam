FoamFile { version 2.0; format ascii; class volVectorField; object U; }
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0.2);
boundaryField
{
    inlet
    {
        // Pulsatile parabolic inflow from constant/boundaryData/inlet
        type            timeVaryingMappedFixedValue;
        mapMethod       nearest;
        offset          (0 0 0);
        setAverage      false;
        value           uniform (0 0 0.2);
    }
    outlet { type inletOutlet; inletValue uniform (0 0 0); value uniform (0 0 0.2); }
    wall   { type movingWallVelocity; value uniform (0 0 0); }
}
