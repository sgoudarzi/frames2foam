FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application     pimpleFoam;

libs            (fourierMotion);
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1.6;
deltaT          1e-4;
writeControl    adjustableRunTime;
writeInterval   0.01;           // 80 frames per cycle (every 2nd exported)
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           1.0;
maxDeltaT       1e-3;
